
import internal:Internal 
    ( replicateMutableArray
    , emptyArray
    , unsafeWriteMutableArray
    , unsafeReadArray
    , unsafeReadMutableArray
    , offsetPointerBytes
    , unsafeArrayContents
    , unsafeFreezeArray
    , unsafeCoerce
    , arrayLength
    , mutableArrayLength
    , unsafeUninitializedMutableArray
    , debugInt
    )
import std:List (List, Cons, Nil)
import std:List
import std:Int
import std:String
import std:Panic (panic, panicAll)
import std:OutArray
import std:OutArray (OutArray)
import std:Ordering (Ordering, Less, Equal, Greater)
import std:Ref
import std:Ref (Ref)
import std:Stream(Stream, Bounded)
import std:ArrayView
import std:ArrayView (ArrayView)
import std:Maybe
import std:Maybe (Maybe, Just, Nothing)

empty : forall a. () -> Array(a)
empty() = emptyArray()

read : forall a. (Array(a), Int) -> a
read(array, index) = {
    boundsCheck(array, index, "std:Array:read")
    unsafeReadArray(array, index)
}

unsafeRead : forall a. (Array(a), Int) -> a
unsafeRead(array, index) = unsafeReadArray(array, index)

readMaybe : forall a. (Array(a), Int) -> Maybe(a)
readMaybe(array, index) = {
    if index >= 0 && index < length(array) then {
        Just(unsafeReadArray(array, index))
    } else {
        Nothing
    }
}

readMutable : forall a. (MutableArray(a), Int) -> a
readMutable(array, index) = {
    boundsCheckMutable(array, index, "std:Array:readMutable")
    unsafeReadMutableArray(array, index)
}

writeMutable : forall a. (MutableArray(a), Int, a) -> ()
writeMutable(array, index, value) = {
    boundsCheckMutable(array, index, "std:Array:writeMutable")
    unsafeWriteMutableArray(array, index, value)
}

-- Replace a value at an index of an immutable array.
--
-- If you want to replace many elements consider using
-- mutableCopy instead of calling this in a loop
--
-- O(n)
replace : forall a. (Array(a), Int, a) -> Array(a)
replace(array, index, newValue) = {
    boundsCheck(array, index, "std:Array:replace")
    let newArray = mutableCopy(array)
    writeMutable(newArray, index, newValue)
    unsafeFreezeArray(newArray)
}

-- Insert a value at an index, pushing the previous value at that index and everything after it over by one.
-- The index can either be a valid index of the array or one past the end, in which case the new element will
-- be appended to the array
--
-- O(n)
insertAt : forall a. (Array(a), Int, a) -> Array(a)
insertAt(array, indexToInsertAt, newValue) = {
    -- We need a custom bounds check so that we can allow indices one past the end of the array
    if indexToInsertAt < 0 || indexToInsertAt >= length(array) + 1 then {
        panicAll(["std:Array:insertAt: index ", Int.toString(indexToInsertAt), " out of bounds for array of length ", Int.toString(length(array))])
    } else {
        generate(length(array) + 1, \newIndex -> {
            match Int.compare(newIndex, indexToInsertAt) {
                Less -> unsafeRead(array, newIndex)
                Equal -> newValue
                Greater -> unsafeRead(array, newIndex - 1)
            }
        })
    }
}

-- Delete the value at the given index and return a new array with all values after it shifted back to fill the gap.
--
-- O(n)
delete : forall a. (Array(a), Int) -> Array(a)
delete(array, deletedIndex) = {
    boundsCheck(array, deletedIndex, "std:Array:delete")
    generate(length(array) - 1, \newIndex -> {
        if newIndex < deletedIndex then {
            unsafeRead(array, newIndex)
        } else {
            unsafeRead(array, newIndex + 1)
        }
    })
}

-- O(|prefix|)
take : forall a. (Array(a), Int) -> Array(a)
take(array, prefixSize) = generate(Int.min(prefixSize, length(array)), \index -> unsafeRead(array, index))

-- O(n - |prefix|)
drop : forall a. (Array(a), Int) -> Array(a)
drop(array, prefixSize) = generate(Int.max(0, length(array) - prefixSize), \index -> unsafeRead(array, index + prefixSize))

-- O(n)
mutableCopy : forall a. Array(a) -> MutableArray(a)
mutableCopy(array) = generateMutable(length(array), \index -> unsafeRead(array, index))

boundsCheck : forall a. (Array(a), Int, String) -> ()
boundsCheck(array, index, name) =
    if index >= 0 && index < arrayLength(array) then 
        ()
    else
        panicAll([name, ": index ", Int.toString(index), " out of bounds for array of length ", Int.toString(length(array))])

boundsCheckMutable : forall a. (MutableArray(a), Int, String) -> ()
boundsCheckMutable(array, index, name) =
    if index >= 0 && index < mutableArrayLength(array) then 
        ()
    else
        panicAll([name, ": index ", Int.toString(index), " out of bounds for array of length ", Int.toString(lengthMutable(array))])


length : forall a. Array(a) -> Int
-- This mostly exists for API consistency but also so user code doesn't need to interact with any of the primops directly
length(array) = arrayLength(array)

lengthMutable : forall a. MutableArray(a) -> Int
lengthMutable(array) = mutableArrayLength(array)

copyArrayView : forall a. ({
        targetArray : MutableArray(a),
        targetOffset : Int,
        source : ArrayView(a)
    }) -> ()
copyArrayView({targetArray, targetOffset, source}) = loop go(index = 0) -> {
    if index < ArrayView.length(source) then {
        writeMutable(targetArray, targetOffset + index, ArrayView.read(source, index))
        go(index + 1)
    } else {}
}

-- TODO: This should probably use some primop that compiles directly to a memmov
-- TODO: bounds checks lol
copyArray : forall a. ({ 
        targetArray : MutableArray(a),
        targetOffset : Int,
        sourceArray : Array(a),
        sourceOffset : Int,
        length : Int
    }) -> ()
copyArray({targetArray, targetOffset, sourceArray, sourceOffset, length}) = {
    let go(i) = {
        if i >= length then () else {
            writeMutable(targetArray, targetOffset + i, read(sourceArray, sourceOffset + i))
            go(i + 1)
        }
    }
    go(0)
}

copyMutableArray : forall a. ({ 
        targetArray : MutableArray(a),
        targetOffset : Int,
        sourceArray : MutableArray(a),
        sourceOffset : Int,
        length : Int
    }) -> ()
copyMutableArray({targetArray, targetOffset, sourceArray, sourceOffset, length}) = {
    let go(i) = {
        if i >= length then () else {
            writeMutable(targetArray, targetOffset + i, readMutable(sourceArray, sourceOffset + i))
            go(i + 1)
        }
    }
    go(0)
}

unsafeWithPointerAtOffset : forall r. (Array(UInt8), Int, Pointer(UInt8) -> r) -> r
unsafeWithPointerAtOffset(array, offset, cont) = {
    cont(offsetPointerBytes(unsafeArrayContents(array), offset))
}

fromView : forall a. ArrayView(a) -> Array(a)
fromView(view) = generate(ArrayView.length(view), \i -> ArrayView.read(view, i))

fromList : forall a. List(a) -> Array(a)
fromList(list) = match list {
    Nil -> emptyArray()
    Cons(first, rest) -> {
        let remainingLength = List.length(rest)
        let array = replicateMutableArray(remainingLength + 1, first)
        
        let go(i, toCopy) = match toCopy {
            Nil -> ()
            Cons(x, shadow rest) -> {
                writeMutable(array, i, x)
                go(i + 1, rest)
            }
        }
        go(1, rest)
        unsafeFreezeArray(array)
    }
}

fromSliceUnsafe : forall a. { array : Array(a), offset : Int, length : Int } -> Array(a)
fromSliceUnsafe({array, offset, length}) = {
    let newArray = unsafeUninitializedMutableArray(length)
    copyArray({
        sourceArray = array,
        sourceOffset = offset,
        targetArray = newArray,
        targetOffset = 0,
        length = length
    })
    unsafeFreezeArray(newArray)
}

for : forall a. (Array(a), a -> ()) -> ()
for(array, f) = {
    let go(i) = if i < arrayLength(array) then {
        f(read(array, i))
        go(i + 1)
    } else {}
    go(0)
}

forIndexed : forall a. (Array(a), (a, Int) -> ()) -> ()
forIndexed(array, f) = {
    let go(i) = if i < arrayLength(array) then {
        f(read(array, i), i)
        go(i + 1)
    } else {}
    go(0)
}

generateMutable : forall a.(Int, Int -> a) -> MutableArray(a)
generateMutable(length, makeElement) = {
    let array = unsafeUninitializedMutableArray(length)
    loop go(i = 0) -> {
        if i < length then {
            writeMutable(array, i, makeElement(i))
            go(i + 1)
        } else {}
    }
    array
}

generate : forall a.(Int, Int -> a) -> Array(a)
generate(length, makeElement) = if length <= 0 then {
    emptyArray()
} else {
    unsafeFreezeArray(generateMutable(length, makeElement))
}

-- Freeze a slice of an MutableArray under the assumption that it will not be used afterwards.
-- If the slice consists of the entire array, the array will be reused in place, otherwise
-- the sub-array will be copied out
unsafeFreezeSlice : forall a. { array : MutableArray(a), offset : Int, length : Int } -> Array(a)
unsafeFreezeSlice({array, offset, length}) = {
    if offset == 0 && length == mutableArrayLength(array) then {
        unsafeFreezeArray(array)
    } else {
        let targetArray = unsafeUninitializedMutableArray(length)
        copyMutableArray({ 
                targetArray = targetArray, 
                targetOffset = 0, 
                sourceArray = array,
                sourceOffset = 0,
                length = length 
            })
        unsafeFreezeArray(targetArray)
    }
}

-- Temporarily expose an Array as a write-only OutArray.
-- This returns the number of elements that have actually been written
withOutArray : forall a r. (MutableArray(a), OutArray(a) -> r) -> (r, Int)
withOutArray(array, f) = withOutArraySlice({ array = array, offset = 0, length = mutableArrayLength(array) }, f)

-- Temporarily expose part of an Array as a write-only OutArray.
-- This returns the number of elements that have actually been written
withOutArraySlice : forall a r. ({ array : MutableArray(a), offset : Int, length : Int }, OutArray(a) -> r) -> (r, Int)
withOutArraySlice({array, offset, length}, f) = {
    -- I don't love how this accesses the OutArray constructor here but i would still prefer for this function to be
    -- defined in std:Array so...
    let nextIndex = Ref.new(0)
    let outArray = OutArray({ buffer = array, offset = offset, size = length, nextIndex = nextIndex })
    let result = f(outArray)
    
    let countWritten = Ref.read(nextIndex)

    (result, countWritten)
}

sliceToStream : forall a. { array : Array(a), offset : Int, length : Int } -> Stream(a)
sliceToStream({ array, offset, length }) = {
    let indexRef = Ref.new(offset)
    Stream({
        sizeHint = Bounded(length),
        run = \outArray -> {
            let index = Ref.read(indexRef)
            if index < length then {
                let lengthToWrite = Int.min(length - index, OutArray.remainingCapacity(outArray))
                OutArray.writeArraySlice(outArray, { array = array, offset = offset + index, length = lengthToWrite })
                Ref.write(indexRef, index + lengthToWrite)
            } else {}
        }
    })
}

view : forall a. Array(a) -> ArrayView(a)
view(array) = ArrayView.fromFunction({ read = \i -> read(array, i), length = length(array) })



flattenView : forall a. (ArrayView(ArrayView(a))) -> Array(a)
flattenView(view) = {
    let totalLength = ArrayView.sum(ArrayView.map(view, \inner -> ArrayView.length(inner)))
    
    let targetArray = unsafeUninitializedMutableArray(totalLength)

    let filledInTotal = ArrayView.foldl(view, 0, \filledSoFar inner -> {
        copyArrayView({ targetArray = targetArray, targetOffset = filledSoFar, source = inner })
        
        filledSoFar + ArrayView.length(inner)
    })

    unsafeFreezeArray(targetArray)
}

flatMapView : forall a b. (ArrayView(a), a -> ArrayView(b)) -> Array(b)
flatMapView(view, f) = flattenView(ArrayView.map(view, f))

equal : forall a. ((a, a) -> Bool, Array(a), Array(a)) -> Bool
equal(comparison, array1, array2) = ArrayView.equal(comparison, view(array1), view(array2))
